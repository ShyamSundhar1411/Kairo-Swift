# Committed deliberately, like .env at the repository root: the team should be
# able to clone and hit run without configuring anything.
#
# This is the team the project was developed and device-tested on. If you are on
# a different Apple ID, either change this line or override it for one run:
#
#     KAIRO_DEV_TEAM=YOURTEAM ./generate.sh
#
# Find your own in Xcode → Settings → Accounts → your Apple ID → the Team list.
KAIRO_DEV_TEAM=8SPY56J4UM

# A free personal Apple ID registers a bundle identifier to one team, so two
# people building the same id on the same account collide. Set a suffix
# (.sibo, .shyam, .aayush) if you hit "failed to register bundle identifier".
KAIRO_BUNDLE_SUFFIX=
