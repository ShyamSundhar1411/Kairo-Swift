# Copy to signing.env (gitignored) and fill in. Each group member has their own.
#
# KAIRO_DEV_TEAM is your 10-character Apple Development Team ID. Find it in
# Xcode → Settings → Accounts → your Apple ID → the Team list, or at
# developer.apple.com → Membership.
KAIRO_DEV_TEAM=

# Optional. A free personal Apple ID can only register a bundle id to one team,
# so if two of you build on the same Mac account, or you hit "failed to register
# bundle identifier", give yourself a suffix: .tony, .sibo, and so on.
KAIRO_BUNDLE_SUFFIX=
