# .env is ignored and untracked, so it never reaches the submission zip. It was
# committed earlier in this repository's history and then removed, which means
# the key is still reachable from the old commits even though it is gone from
# the working tree - rotate it when the unit ends rather than trusting the
# delete. Each machine makes its own from .env.example.

# LAN token, per machine
.kairo-lan-token
.kairo-fly-token

# Intermediate render output - the published cut is brag-output/brag.mp4
brag-output/composition/renders/
.kairo-demo

# Office lock files, written while a document is open
~$*
